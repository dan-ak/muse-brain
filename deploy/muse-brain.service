[Unit]
Description=Muse PWA host (HTTPS app + player telemetry websockets)
Documentation=file:///opt/muse-brain/docs/pi-deployment.md
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=muse
Group=muse
WorkingDirectory=/opt/muse-brain

Environment=MUSE_HOST=0.0.0.0
Environment=MUSE_PORT=443
Environment=MUSE_TLS_CERT=/etc/muse-brain/tls/fullchain.pem
Environment=MUSE_TLS_KEY=/etc/muse-brain/tls/privkey.pem

ExecStart=/opt/muse-brain/.venv/bin/python /opt/muse-brain/server.py

# Bind 443 without running as root, so phones open a bare hostname with no
# port. The private key is chown root:muse mode 640, readable via the group.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/etc/muse-brain

Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
